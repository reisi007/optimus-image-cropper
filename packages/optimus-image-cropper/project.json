{
  "name": "optimus-image-cropper",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/optimus-image-cropper/src",
  "prefix": "oic",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:optimus-image-cropper"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/optimus-image-cropper/ng-package.json",
        "tsConfig": "packages/optimus-image-cropper/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/optimus-image-cropper/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": 0
      }
    }
  }
}
